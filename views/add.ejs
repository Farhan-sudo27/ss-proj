<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="./add.css"/>
    <title>Add Stocks</title>
</head>
<body>
    <h2 class="add-heading">Add Stocks</h2>
    <form action="/add" method="POST" enctype="multipart/form-data" class="stock-form-container">
    
    <div class="form-group upload-form">
        <label for="image-upload" class="custom-file-upload">
            <i class="bi bi-camera-fill"></i> Choose Image
        </label>
        <input type="file" id="image-upload" name="image" accept="image/*" required />
    </div>
    
    <div class="note-form">
        <label for="note-input" id="note-label">Note</label>
        <textarea class = "note-input" id="note-input" type="text" name="note" placeholder="a note about your stock..." required autofocus autocomplete="off"></textarea>
        <button type="submit" class="btn btn-secondary text-submit">Upload Stock</button>
    </div>
    

</form>
</body>
</html>